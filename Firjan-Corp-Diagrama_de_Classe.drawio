<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="stj5bHrdo7WfKRvWQMV7">
    <mxGraphModel dx="6847" dy="3650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\n&#39; --- Classes de Entidade (Modelos) ---\n\nclass Entidade {\n  + id : String\n  + constructor()\n}\n\nclass Colaborador {\n  + nome : String\n  + cpf : String\n  + setorId : String\n  + cargoId : String\n  + constructor(nome, cpf, setorId, cargoId)\n  + validar() : Boolean\n}\n\nclass Setor {\n  + nome : String\n  + local : String\n  + constructor(nome, local)\n  + obterInfoCompleta() : String\n}\n\nclass Cargo {\n  + nome : String\n  + risco : String\n  + constructor(nome, risco)\n  + obterRiscoFormatado() : String\n}\n\nclass EPI {\n  + nome : String\n  + ca : String\n  + qtd : int\n  + constructor(nome, ca, qtd)\n  + atualizarEstoque(quantidade) : void\n}\n\nclass EntregaEPI {\n  + colabId : String\n  + epiId : String\n  + data : String\n  + qtdEntregue : int\n  + constructor(colabId, epiId, data, qtdEntregue)\n  + obterDataFormatada() : String\n}\n\nclass ExameMedico {\n  + colabId : String\n  + tipo : String\n  + data : String\n  + resultado : String\n  + constructor(colabId, tipo, data, resultado)\n  + verificarAptidao() : Boolean\n}\n\nclass Treinamento {\n  + nome : String\n  + data : String\n  + cargaHoraria : int\n  + constructor(nome, data, cargaHoraria)\n  + estaValido(dataAtual) : Boolean\n}\n\nclass RegistroAcidente {\n  + colabId : String\n  + data : String\n  + descricao : String\n  + gravidade : String\n  + constructor(colabId, data, descricao, gravidade)\n  + classificarRisco() : String\n}\n\nclass InspecaoSeguranca {\n  + setorId : String\n  + data : String\n  + status : String\n  + observacao : String\n  + constructor(setorId, data, status, observacao)\n  + obterStatusBadge() : String\n}\n\n&#39; --- Heranças ---\nEntidade &lt;|-- Colaborador\nEntidade &lt;|-- Setor\nEntidade &lt;|-- Cargo\nEntidade &lt;|-- EPI\nEntidade &lt;|-- EntregaEPI\nEntidade &lt;|-- ExameMedico\nEntidade &lt;|-- Treinamento\nEntidade &lt;|-- RegistroAcidente\nEntidade &lt;|-- InspecaoSeguranca\n\n&#39; --- Engenharia do Sistema e Interface ---\n\nclass SSTSystem {\n  + banco : Object\n  + constructor()\n  + salvarStorage() : void\n  + carregarStorage() : void\n  + cadastrar(modulo, objeto) : void\n  + listar(modulo) : Array\n  + atualizar(modulo, id, novosDados) : Boolean\n  + excluir(modulo, id) : Boolean\n  + gerarRelatorioGeral() : Object\n}\n\nclass AppFront {\n  + backend : SSTSystem\n  + moduloAtual : String\n  + constructor()\n  + inicializarMassaDadosSimulada() : void\n  + mudarModulo(modulo) : void\n  + renderizarDashboard() : void\n  + renderizarFormularioECrud() : void\n  + optionsSelect(modulo) : String\n  + construirTabelaDados(modulo, elementoTabela) : void\n  + handleFormSubmit(e) : void\n  + carregarDadosParaEdicao(modulo, id) : void\n  + deletarRegistro(modulo, id) : void\n  + limparFormulario() : void\n}\n\n&#39; --- Relacionamentos Lógicos de Dependência ---\nSSTSystem \&quot;1\&quot; *-- \&quot;muitos\&quot; Entidade : gerencia no banco\nAppFront \&quot;1\&quot; --&gt; \&quot;1\&quot; SSTSystem : utiliza controlador\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="wDvN2p39SnUcaXxU4MOY-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1790" width="6072.79" x="-320" y="40" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
